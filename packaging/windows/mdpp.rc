// Windows resources of mdpp.exe: the program icon and the version shown in its Properties.
// A template: crates/mdpp-app/build.rs fills @ICON@, @MAJOR@, @MINOR@, @PATCH@ and @VERSION@
// (from Cargo.toml).
#include <winver.h>

1 ICON "@ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @MAJOR@, @MINOR@, @PATCH@, 0
PRODUCTVERSION @MAJOR@, @MINOR@, @PATCH@, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "MD++ contributors"
            VALUE "FileDescription", "MD++ Markdown editor"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "mdpp"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
            VALUE "OriginalFilename", "mdpp.exe"
            VALUE "ProductName", "MD++"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
